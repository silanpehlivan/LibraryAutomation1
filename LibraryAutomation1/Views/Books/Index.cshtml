@model IEnumerable<LibraryAutomation1.Models.Book>

@{
    ViewData["Title"] = "Kitaplar";
}

<div class="container-fluid">
    <!-- Başlık ve Butonlar -->
    <div class="row mb-3">
        <div class="col-md-6">
            <h2><i class="fas fa-book"></i> Kitap Yönetimi</h2>
        </div>
        <div class="col-md-6 text-right">
            <a asp-action="Create" class="btn btn-primary">
                <i class="fas fa-plus"></i> Yeni Kitap Ekle
            </a>
            <a asp-action="TopRated" class="btn btn-info">
                <i class="fas fa-star"></i> En Yüksek Puanlılar
            </a>
        </div>
    </div>

    <!-- Arama ve Filtreleme -->
    <div class="card mb-3">
        <div class="card-body">
            <form method="get" asp-action="Index">
                <div class="row">
                    <div class="col-md-3">
                        <div class="form-group">
                            <label>Arama</label>
                            <input type="text" name="searchString" value="@ViewData["CurrentFilter"]"
                                   class="form-control" placeholder="Kitap adı, yazar veya ISBN" />
                        </div>
                    </div>
                    <div class="col-md-2">
                        <div class="form-group">
                            <label>Tür</label>
                            <select name="genreFilter" class="form-control">
                                <option value="">Tüm Türler</option>
                                @foreach (var genre in ViewBag.Genres)
                                {
                                    <option value="@genre" selected="@(genre == ViewData["GenreFilter"])">@genre</option>
                                }
                            </select>
                        </div>
                    </div>
                    <div class="col-md-2">
                        <div class="form-group">
                            <label>Yazar</label>
                            <select name="authorFilter" class="form-control">
                                <option value="">Tüm Yazarlar</option>
                                @foreach (var author in ViewBag.Authors)
                                {
                                    <option value="@author" selected="@(author == ViewData["AuthorFilter"])">@author</option>
                                }
                            </select>
                        </div>
                    </div>
                    <div class="col-md-2">
                        <div class="form-group">
                            <label>Yayın Yılı</label>
                            <select name="yearFilter" class="form-control">
                                <option value="">Tüm Yıllar</option>
                                @foreach (var year in ViewBag.Years)
                                {
                                   <option value="@year" selected="@(ViewData["YearFilter"] != null && year == (int)ViewData["YearFilter"])">@year</option>
                                }
                            </select>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-group">
                            <label>&nbsp;</label>
                            <div>
                                <button type="submit" class="btn btn-primary">
                                    <i class="fas fa-search"></i> Ara
                                </button>
                                <a asp-action="Index" class="btn btn-secondary">
                                    <i class="fas fa-times"></i> Temizle
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- Sıralama Linkleri -->
    <div class="mb-3">
        <strong>Sıralama:</strong>
        <a asp-action="Index" asp-route-sortOrder="@ViewData["TitleSortParm"]"
           asp-route-searchString="@ViewData["CurrentFilter"]"
           asp-route-genreFilter="@ViewData["GenreFilter"]"
           asp-route-authorFilter="@ViewData["AuthorFilter"]"
           asp-route-yearFilter="@ViewData["YearFilter"]">
            Kitap Adı
        </a> |
        <a asp-action="Index" asp-route-sortOrder="@ViewData["AuthorSortParm"]"
           asp-route-searchString="@ViewData["CurrentFilter"]"
           asp-route-genreFilter="@ViewData["GenreFilter"]"
           asp-route-authorFilter="@ViewData["AuthorFilter"]"
           asp-route-yearFilter="@ViewData["YearFilter"]">
            Yazar
        </a> |
        <a asp-action="Index" asp-route-sortOrder="@ViewData["YearSortParm"]"
           asp-route-searchString="@ViewData["CurrentFilter"]"
           asp-route-genreFilter="@ViewData["GenreFilter"]"
           asp-route-authorFilter="@ViewData["AuthorFilter"]"
           asp-route-yearFilter="@ViewData["YearFilter"]">
            Yayın Yılı
        </a> |
        <a asp-action="Index" asp-route-sortOrder="@ViewData["RatingSortParm"]"
           asp-route-searchString="@ViewData["CurrentFilter"]"
           asp-route-genreFilter="@ViewData["GenreFilter"]"
           asp-route-authorFilter="@ViewData["AuthorFilter"]"
           asp-route-yearFilter="@ViewData["YearFilter"]">
            Puan
        </a>
    </div>

    <!-- Kitap Listesi -->
    <div class="card">
        <div class="card-body">
            @if (Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead class="thead-dark">
                            <tr>
                                <th>Kapak</th>
                                <th>Kitap Bilgileri</th>
                                <th>Tür/Kategori</th>
                                <th>Raf</th>
                                <th>Durum</th>
                                <th>Puan</th>
                                <th>İşlemler</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>
                                        @if (!string.IsNullOrEmpty(item.CoverImageUrl))
                                        {
                                            <img src="@item.CoverImageUrl" alt="@item.Title"
                                                 class="img-thumbnail" style="width: 50px; height: 70px; object-fit: cover;" />
                                        }
                                        else
                                        {
                                            <div class="bg-secondary text-white d-flex align-items-center justify-content-center"
                                                 style="width: 50px; height: 70px; font-size: 12px;">
                                                Kapak<br />Yok
                                            </div>
                                        }
                                    </td>
                                    <td>
                                        <strong>@Html.DisplayFor(modelItem => item.Title)</strong><br />
                                        <small class="text-muted">
                                            @Html.DisplayFor(modelItem => item.Author)
                                            (@Html.DisplayFor(modelItem => item.PublicationYear))
                                        </small><br />
                                        @if (!string.IsNullOrEmpty(item.Publisher))
                                        {
                                            <small class="text-info">@item.Publisher</small>
                                
                                            <br />
                                        }
                                        @if (!string.IsNullOrEmpty(item.ISBN))
                                        {
                                            <small class="text-muted">ISBN: @item.ISBN</small>
                                        }
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(item.Genre))
                                        {
                                            <span class="badge badge-info">@item.Genre</span>
                                
                                            <br />
                                        }
                                        @if (!string.IsNullOrEmpty(item.Category))
                                        {
                                            <span class="badge badge-secondary">@item.Category</span>
                                        }
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(item.ShelfNumber))
                                        {
                                            <span class="badge badge-dark">@item.ShelfNumber</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                    </td>
                                    <td>
                                        @if (item.IsAvailable)
                                        {
                                            <span class="badge badge-success">
                                                <i class="fas fa-check"></i> Müsait
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge badge-danger">
                                                <i class="fas fa-times"></i> Ödünç Verilmiş
                                            </span>
                                        }
                                    </td>
                                    <td>
                                        @if (item.RatingCount > 0)
                                        {
                                            <div class="rating-display">
                                                @for (int i = 1; i <= 5; i++)
                                                {
                                                    if (i <= Math.Round(item.AverageRating))
                                                    {
                                                        <i class="fas fa-star text-warning"></i>
                                                    }
                                                    else
                                                    {
                                                        <i class="far fa-star text-muted"></i>
                                                    }
                                                }
                                                <br />
                                                <small class="text-muted">
                                                    @item.AverageRating.ToString("F1") (@item.RatingCount puan)
                                                </small>
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                <i class="far fa-star"></i> Puanlanmamış
                                            </span>
                                        }
                                    </td>
                                    <td>
                                        <div class="btn-group-vertical btn-group-sm">
                                            <a asp-action="Details" asp-route-id="@item.Id"
                                               class="btn btn-info btn-sm" title="Detaylar">
                                                <i class="fas fa-eye"></i>
                                            </a>
                                            <a asp-action="Edit" asp-route-id="@item.Id"
                                               class="btn btn-warning btn-sm" title="Düzenle">
                                                <i class="fas fa-edit"></i>
                                            </a>
                                            <a asp-action="Delete" asp-route-id="@item.Id"
                                               class="btn btn-danger btn-sm" title="Sil">
                                                <i class="fas fa-trash"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <i class="fas fa-book fa-3x text-muted mb-3"></i>
                    <h4 class="text-muted">Kitap bulunamadı</h4>
                    <p class="text-muted">Arama kriterlerinizi değiştirmeyi deneyin veya yeni kitap ekleyin.</p>
                    <a asp-action="Create" class="btn btn-primary">
                        <i class="fas fa-plus"></i> İlk Kitabı Ekle
                    </a>
                </div>
            }
        </div>
    </div>

    <!-- İstatistikler -->
    <div class="row mt-3">
        <div class="col-md-12">
            <div class="card">
                <div class="card-body">
                    <div class="row text-center">
                        <div class="col-md-3">
                            <h5 class="text-primary">@Model.Count()</h5>
                            <small class="text-muted">Toplam Sonuç</small>
                        </div>
                        <div class="col-md-3">
                            <h5 class="text-success">@Model.Count(b => b.IsAvailable)</h5>
                            <small class="text-muted">Müsait Kitap</small>
                        </div>
                        <div class="col-md-3">
                            <h5 class="text-warning">@Model.Count(b => b.RatingCount > 0)</h5>
                            <small class="text-muted">Puanlanmış</small>
                        </div>
                        <div class="col-md-3">
                            <h5 class="text-info">@(Model.Any(b => b.RatingCount > 0) ? Model.Where(b => b.RatingCount > 0).Average(b => b.AverageRating).ToString("F1") : "0.0")</h5>
                            <small class="text-muted">Ortalama Puan</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            // Tooltip'leri etkinleştir
            $('[data-toggle="tooltip"]').tooltip();

            // Tablo satırlarına hover efekti
            $('.table tbody tr').hover(
                function() { $(this).addClass('table-active'); },
                function() { $(this).removeClass('table-active'); }
            );
        });
    </script>
}

