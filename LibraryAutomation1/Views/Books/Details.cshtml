@model LibraryAutomation1.Models.Book

@{
    ViewData["Title"] = "Kitap Detayı - " + Model.Title;
}

<div class="container-fluid">
    <div class="row">
        <!-- Sol Kolon - Kitap Bilgileri -->
        <div class="col-md-8">
            <div class="card">
                <div class="card-header">
                    <h3 class="card-title">
                        <i class="fas fa-book"></i> @Model.Title
                    </h3>
                </div>
                <div class="card-body">
                    <div class="row">
                        <!-- Kapak Resmi -->
                        <div class="col-md-3">
                            @if (!string.IsNullOrEmpty(Model.CoverImageUrl))
                            {
                                <img src="@Model.CoverImageUrl" alt="@Model.Title"
                                     class="img-fluid rounded shadow" style="max-height: 300px;" />
                            }
                            else
                            {
                                <div class="bg-secondary text-white d-flex align-items-center justify-content-center rounded"
                                     style="height: 300px; font-size: 18px;">
                                    <div class="text-center">
                                        <i class="fas fa-book fa-3x mb-2"></i><br />
                                        Kapak Resmi<br />Bulunmuyor
                                    </div>
                                </div>
                            }
                        </div>

                        <!-- Kitap Detayları -->
                        <div class="col-md-9">
                            <dl class="row">
                                <dt class="col-sm-3">Kitap Adı:</dt>
                                <dd class="col-sm-9"><strong>@Model.Title</strong></dd>

                                <dt class="col-sm-3">Yazar:</dt>
                                <dd class="col-sm-9">@Model.Author</dd>

                                <dt class="col-sm-3">Yayın Yılı:</dt>
                                <dd class="col-sm-9">@Model.PublicationYear</dd>

                                @if (!string.IsNullOrEmpty(Model.Publisher))
                                {
                                    <dt class="col-sm-3">Yayınevi:</dt>
                                    <dd class="col-sm-9">@Model.Publisher</dd>
                                }

                                @if (!string.IsNullOrEmpty(Model.Genre))
                                {
                                    <dt class="col-sm-3">Tür:</dt>
                                    <dd class="col-sm-9">
                                        <span class="badge badge-info">@Model.Genre</span>
                                    </dd>
                                }

                                @if (!string.IsNullOrEmpty(Model.Category))
                                {
                                    <dt class="col-sm-3">Kategori:</dt>
                                    <dd class="col-sm-9">
                                        <span class="badge badge-secondary">@Model.Category</span>
                                    </dd>
                                }

                                @if (!string.IsNullOrEmpty(Model.ISBN))
                                {
                                    <dt class="col-sm-3">ISBN:</dt>
                                    <dd class="col-sm-9"><code>@Model.ISBN</code></dd>
                                }

                                @if (Model.PageCount.HasValue)
                                {
                                    <dt class="col-sm-3">Sayfa Sayısı:</dt>
                                    <dd class="col-sm-9">@Model.PageCount sayfa</dd>
                                }

                                @if (!string.IsNullOrEmpty(Model.ShelfNumber))
                                {
                                    <dt class="col-sm-3">Raf Numarası:</dt>
                                    <dd class="col-sm-9">
                                        <span class="badge badge-dark">@Model.ShelfNumber</span>
                                    </dd>
                                }

                                <dt class="col-sm-3">Durum:</dt>
                                <dd class="col-sm-9">
                                    @if (Model.IsAvailable)
                                    {
                                        <span class="badge badge-success">
                                            <i class="fas fa-check"></i> Müsait
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-danger">
                                            <i class="fas fa-times"></i> Ödünç Verilmiş
                                        </span>
                                    }
                                </dd>
                            </dl>

                            @if (!string.IsNullOrEmpty(Model.Description))
                            {
                                <div class="mt-3">
                                    <h5>Açıklama:</h5>
                                    <p class="text-justify">@Model.Description</p>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Sağ Kolon - Puanlama ve İstatistikler -->
        <div class="col-md-4">
            <!-- Puanlama Kartı -->
            <div class="card mb-3">
                <div class="card-header">
                    <h5 class="card-title">
                        <i class="fas fa-star"></i> Puanlama
                    </h5>
                </div>
                <div class="card-body text-center">
                    @if (Model.RatingCount > 0)
                    {
                        <div class="mb-3">
                            <h2 class="text-warning">@Model.AverageRating.ToString("F1")</h2>
                            <div class="rating-display mb-2">
                                @for (int i = 1; i <= 5; i++)
                                {
                                    if (i <= Math.Round(Model.AverageRating))
                                    {
                                        <i class="fas fa-star text-warning fa-lg"></i>
                                    }
                                    else
                                    {
                                        <i class="far fa-star text-muted fa-lg"></i>
                                    }
                                }
                            </div>
                            <small class="text-muted">@Model.RatingCount kişi puanladı</small>
                        </div>
                    }
                    else
                    {
                        <div class="mb-3">
                            <h4 class="text-muted">Henüz puanlanmamış</h4>
                            <div class="rating-display mb-2">
                                @for (int i = 1; i <= 5; i++)
                                {
                                    <i class="far fa-star text-muted fa-lg"></i>
                                }
                            </div>
                            <small class="text-muted">İlk puanı siz verin!</small>
                        </div>
                    }

                    <!-- Puanlama Formu -->
                    @{
                        var currentMemberId = Context.Session.GetString("MemberId");
                        var currentMemberName = Context.Session.GetString("MemberName");
                    }

                    @if (!string.IsNullOrEmpty(currentMemberId))
                    {
                        var userRating = Model.BookRatings?.FirstOrDefault(br => br.MemberId.ToString() == currentMemberId);

                        <form asp-controller="Books" asp-action="RateBook" method="post">
                            <input type="hidden" name="bookId" value="@Model.Id" />
                            <input type="hidden" name="memberId" value="@currentMemberId" />

                            <div class="form-group">
                                <label>Puanınız:</label>
                                <div class="rating-input">
                                    @for (int i = 1; i <= 5; i++)
                                    {
                                        <input type="radio" name="rating" value="@i" id="star@i"
                                               @(userRating != null && userRating.Rating == i ? "checked" : "") />
                                        <label for="star@i" class="star-label">
                                            <i class="fas fa-star"></i>
                                        </label>
                                    }
                                </div>
                            </div>

                            <div class="form-group">
                                <textarea name="comment" class="form-control" rows="3"
                                      placeholder="Yorumunuz (isteğe bağlı)">@(userRating?.Comment ?? "")</textarea>
                            </div>

                            <button type="submit" class="btn btn-warning">
                                <i class="fas fa-star"></i>
                                @(userRating != null ? "Puanı Güncelle" : "Puan Ver")
                            </button>
                        </form>
                    }
                    else
                    {
                        <div class="alert alert-info">
                            <i class="fas fa-info-circle"></i>
                            Puan verebilmek için <a asp-controller="Members" asp-action="Login">giriş yapın</a>.
                        </div>
                    }
                </div>
            </div>

            <!-- İşlem Butonları -->
            <div class="card mb-3">
                <div class="card-body">
                    <div class="d-grid gap-2">
                        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">
                            <i class="fas fa-edit"></i> Düzenle
                        </a>
                        @if (Model.IsAvailable)
                        {
                            <a asp-controller="Loans" asp-action="Create" asp-route-bookId="@Model.Id"
                               class="btn btn-success">
                                <i class="fas fa-hand-holding"></i> Ödünç Ver
                            </a>
                        }
                        <a asp-action="Index" class="btn btn-secondary">
                            <i class="fas fa-arrow-left"></i> Kitap Listesi
                        </a>
                    </div>
                </div>
            </div>

            <!-- Ödünç Geçmişi -->
            @if (Model.Loans != null && Model.Loans.Any())
            {
                <div class="card">
                    <div class="card-header">
                        <h6 class="card-title">
                            <i class="fas fa-history"></i> Ödünç Geçmişi
                        </h6>
                    </div>
                    <div class="card-body">
                        <div class="timeline">
                            @foreach (var loan in Model.Loans.OrderByDescending(l => l.LoanDate).Take(5))
                            {
                                <div class="timeline-item">
                                    <div class="timeline-marker
                                                @(loan.ReturnDate == null ? "bg-warning" : "bg-success")">
                                        <i class="fas @(loan.ReturnDate == null ? "fa-clock" : "fa-check")"></i>
                                    </div>
                                    <div class="timeline-content">
                                        <small class="text-muted">@loan.LoanDate.ToString("dd.MM.yyyy")</small><br />
                                        <strong>@loan.Member.FullName</strong><br />
                                        @if (loan.ReturnDate == null)
                                        {
                                            <span class="badge badge-warning">Aktif</span>
                                            <small class="text-muted">
                                                Teslim: @loan.DueDate.ToString("dd.MM.yyyy")
                                            </small>
                                        }
                                        else
                                        {
                                            <span class="badge badge-success">İade Edildi</span>
                                            <small class="text-muted">
                                                @loan.ReturnDate.Value.ToString("dd.MM.yyyy")
                                            </small>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>

    <!-- Yorumlar Bölümü -->
    @if (Model.BookRatings != null && Model.BookRatings.Any(br => !string.IsNullOrEmpty(br.Comment)))
    {
        <div class="row mt-4">
            <div class="col-md-12">
                <div class="card">
                    <div class="card-header">
                        <h5 class="card-title">
                            <i class="fas fa-comments"></i> Yorumlar
                        </h5>
                    </div>
                    <div class="card-body">
                        @foreach (var rating in Model.BookRatings.Where(br => !string.IsNullOrEmpty(br.Comment)).OrderByDescending(br => br.RatingDate))
                        {
                            <div class="media mb-3">
                                <div class="media-object mr-3">
                                    <div class="avatar bg-primary text-white rounded-circle d-flex align-items-center justify-content-center"
                                         style="width: 40px; height: 40px;">
                                        @rating.Member.FirstName.Substring(0, 1)@rating.Member.LastName.Substring(0, 1)
                                    </div>
                                </div>
                                <div class="media-body">
                                    <div class="d-flex justify-content-between">
                                        <h6 class="mt-0">@rating.Member.FullName</h6>
                                        <small class="text-muted">@rating.RatingDate.ToString("dd.MM.yyyy")</small>
                                    </div>
                                    <div class="rating-display mb-1">
                                        @for (int i = 1; i <= 5; i++)
                                        {
                                            if (i <= rating.Rating)
                                            {
                                                <i class="fas fa-star text-warning"></i>
                                            }
                                            else
                                            {
                                                <i class="far fa-star text-muted"></i>
                                            }
                                        }
                                    </div>
                                    <p>@rating.Comment</p>
                                </div>
                            </div>
                            <hr />
                        }
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@section Styles {
    <style>
        .rating-input {
            display: flex;
            flex-direction: row-reverse;
            justify-content: center;
            margin-bottom: 1rem;
        }

            .rating-input input[type="radio"] {
                display: none;
            }

            .rating-input .star-label {
                cursor: pointer;
                color: #ddd;
                font-size: 1.5rem;
                margin: 0 2px;
                transition: color 0.2s;
            }

                .rating-input .star-label:hover,
                .rating-input .star-label:hover ~ .star-label,
                .rating-input input[type="radio"]:checked ~ .star-label {
                    color: #ffc107;
                }

        .timeline {
            position: relative;
            padding-left: 30px;
        }

            .timeline::before {
                content: '';
                position: absolute;
                left: 15px;
                top: 0;
                bottom: 0;
                width: 2px;
                background: #dee2e6;
            }

        .timeline-item {
            position: relative;
            margin-bottom: 20px;
        }

        .timeline-marker {
            position: absolute;
            left: -22px;
            width: 30px;
            height: 30px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 12px;
        }

        .timeline-content {
            background: #f8f9fa;
            padding: 10px;
            border-radius: 5px;
            border-left: 3px solid #007bff;
        }

        .avatar {
            font-size: 14px;
            font-weight: bold;
        }
    </style>
}

@section Scripts {
    <script>
        $(document).ready(function() {
            // Rating input hover effects
            $('.rating-input .star-label').hover(
                function() {
                    $(this).addClass('text-warning');
                    $(this).nextAll('.star-label').addClass('text-warning');
                },
                function() {
                    if (!$(this).prev('input[type="radio"]').is(':checked')) {
                        $(this).removeClass('text-warning');
                        $(this).nextAll('.star-label').removeClass('text-warning');
                    }
                }
            );
        });
    </script>
}


