@model dynamic

@{
    ViewData["Title"] = "Kütüphane Yönetim Sistemi";
}

<div class="container-fluid">
    <!-- Başlık -->
    <div class="row mb-4">
        <div class="col-md-12">
            <h1 class="display-4">
                <i class="fas fa-book-open text-primary"></i>
                Kütüphane Yönetim Sistemi
            </h1>
            <p class="lead text-muted">Hoş geldiniz! Kütüphane istatistiklerinizi ve son aktiviteleri buradan takip edebilirsiniz.</p>
        </div>
    </div>

    <!-- İstatistik Kartları -->
    <div class="row mb-4">
        <div class="col-lg-2 col-md-4 col-sm-6 mb-3">
            <div class="card bg-primary text-white">
                <div class="card-body">
                    <div class="d-flex justify-content-between">
                        <div>
                            <h4 class="mb-0">@Model.TotalBooks</h4>
                            <small>Toplam Kitap</small>
                        </div>
                        <div class="align-self-center">
                            <i class="fas fa-book fa-2x"></i>
                        </div>
                    </div>
                </div>
                <div class="card-footer">
                    <a href="@Url.Action("Index", "Books")" class="text-white">
                        <small>Detayları Gör <i class="fas fa-arrow-right"></i></small>
                    </a>
                </div>
            </div>
        </div>

        <div class="col-lg-2 col-md-4 col-sm-6 mb-3">
            <div class="card bg-success text-white">
                <div class="card-body">
                    <div class="d-flex justify-content-between">
                        <div>
                            <h4 class="mb-0">@Model.AvailableBooks</h4>
                            <small>Müsait Kitap</small>
                        </div>
                        <div class="align-self-center">
                            <i class="fas fa-check-circle fa-2x"></i>
                        </div>
                    </div>
                </div>
                <div class="card-footer d-flex justify-content-between align-items-center">
                    <small style="display:none;">
                        @{
                            double availablePercentage = Model.TotalBooks > 0
                            ? (double)Model.AvailableBooks / Model.TotalBooks * 100
                            : 0;
                        }
                        @availablePercentage.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)%
                    </small>

                    <a href="@Url.Action("Index", "Books")" class="small text-white">
                        Kitapları Gör <i class="fas fa-angle-right"></i>
                    </a>
                </div>
            </div>
        </div>

        <div class="col-lg-2 col-md-4 col-sm-6 mb-3">
            <div class="card bg-info text-white">
                <div class="card-body">
                    <div class="d-flex justify-content-between">
                        <div>
                            <h4 class="mb-0">@Model.TotalMembers</h4>
                            <small>Aktif Üye</small>
                        </div>
                        <div class="align-self-center">
                            <i class="fas fa-users fa-2x"></i>
                        </div>
                    </div>
                </div>
                <div class="card-footer">
                    <a href="@Url.Action("Index", "Members")" class="text-white">
                        <small>Üyeleri Gör <i class="fas fa-arrow-right"></i></small>
                    </a>
                </div>
            </div>
        </div>

        <div class="col-lg-2 col-md-4 col-sm-6 mb-3">
            <div class="card bg-warning text-white">
                <div class="card-body">
                    <div class="d-flex justify-content-between">
                        <div>
                            <h4 class="mb-0">@Model.ActiveLoans</h4>
                            <small>Aktif Ödünç</small>
                        </div>
                        <div class="align-self-center">
                            <i class="fas fa-hand-holding fa-2x"></i>
                        </div>
                    </div>
                </div>
                <div class="card-footer">
                    <a href="@Url.Action("Index", "Loans")" class="text-white">
                        <small>Ödünçleri Gör <i class="fas fa-arrow-right"></i></small>
                    </a>
                </div>
            </div>
        </div>

        <div class="col-lg-2 col-md-4 col-sm-6 mb-3">
            <div class="card bg-danger text-white">
                <div class="card-body">
                    <div class="d-flex justify-content-between">
                        <div>
                            <h4 class="mb-0">@Model.OverdueLoans</h4>
                            <small>Gecikmeli</small>
                        </div>
                        <div class="align-self-center">
                            <i class="fas fa-exclamation-triangle fa-2x"></i>
                        </div>
                    </div>
                </div>
                <div class="card-footer">
                    <a href="@Url.Action("OverdueBooks", "Loans")" class="text-white">
                        <small>Gecikmeleri Gör <i class="fas fa-arrow-right"></i></small>
                    </a>
                </div>
            </div>
        </div>

        <div class="col-lg-2 col-md-4 col-sm-6 mb-3">
            <div class="card bg-secondary text-white">
                <div class="card-body">
                    <div class="d-flex justify-content-between">
                        <div>
                            <h4 class="mb-0">@Model.TotalRatings</h4>
                            <small>Toplam Puan</small>
                        </div>
                        <div class="align-self-center">
                            <i class="fas fa-star fa-2x"></i>
                        </div>
                    </div>
                </div>
                <div class="card-footer">
                    <a href="@Url.Action("RatingStats", "Reports")" class="text-white">
                        <small>İstatistikleri Gör <i class="fas fa-arrow-right"></i></small>
                    </a>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <!-- Sol Kolon -->
        <div class="col-lg-8">
            <!-- Son Eklenen Kitaplar -->
            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="card-title">
                        <i class="fas fa-plus-circle text-success"></i> Son Eklenen Kitaplar
                    </h5>
                </div>
                <div class="card-body">
                    @if (Model.RecentBooks != null && Model.RecentBooks.Count > 0)
                    {
                        <div class="row">
                            @foreach (var book in Model.RecentBooks)
                            {
                                <div class="col-md-6 mb-3">
                                    <div class="media">
                                        <div class="media-object mr-3">
                                            @if (!string.IsNullOrEmpty(book.CoverImageUrl))
                                            {
                                                <img src="@book.CoverImageUrl" alt="@book.Title"
                                                     class="img-thumbnail" style="width: 60px; height: 80px; object-fit: cover;" />
                                            }
                                            else
                                            {
                                                <div class="bg-secondary text-white d-flex align-items-center justify-content-center"
                                                     style="width: 60px; height: 80px; font-size: 10px;">
                                                    Kapak<br />Yok
                                                </div>
                                            }
                                        </div>
                                        <div class="media-body">
                                            <h6 class="mt-0">
                                                <a href="@Url.Action("Details", "Books", new { id = book.Id })">
                                                    @book.Title
                                                </a>
                                            </h6>
                                            <small class="text-muted">@book.Author (@book.PublicationYear)</small><br />
                                            @if (!string.IsNullOrEmpty(book.Genre))
                                            {
                                                <span class="badge badge-info badge-sm">@book.Genre</span>
                                            }
                                            @if (book.IsAvailable)
                                            {
                                                <span class="badge badge-success badge-sm">Müsait</span>
                                            }
                                            else
                                            {
                                                <span class="badge badge-danger badge-sm">Ödünç Verilmiş</span>
                                            }
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="text-muted">Henüz kitap eklenmemiş.</p>
                    }
                </div>
                <div class="card-footer">
                    <a href="@Url.Action("Index", "Books")" class="btn btn-primary btn-sm">
                        <i class="fas fa-list"></i> Tüm Kitapları Gör
                    </a>
                    <a href="@Url.Action("Create", "Books")" class="btn btn-success btn-sm">
                        <i class="fas fa-plus"></i> Yeni Kitap Ekle
                    </a>
                </div>
            </div>

            <!-- En Yüksek Puanlı Kitaplar -->
            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="card-title">
                        <i class="fas fa-star text-warning"></i> En Yüksek Puanlı Kitaplar
                    </h5>
                </div>
                <div class="card-body">
                    @if (Model.TopRatedBooks != null && Model.TopRatedBooks.Count > 0)
                    {
                        <div class="table-responsive">
                            <table class="table table-sm">
                                <thead>
                                    <tr>
                                        <th>Kitap</th>
                                        <th>Yazar</th>
                                        <th>Puan</th>
                                        <th>Değerlendirme</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var book in Model.TopRatedBooks)
                                    {
                                        <tr>
                                            <td>
                                                <a href="@Url.Action("Details", "Books", new { id = book.Id })">
                                                    @book.Title
                                                </a>
                                            </td>
                                            <td>@book.Author</td>
                                            <td>
                                                <div class="rating-display">
                                                    @for (int i = 1; i <= 5; i++)
                                                    {
                                                        if (i <= Math.Round(book.AverageRating))
                                                        {
                                                            <i class="fas fa-star text-warning"></i>
                                                        }
                                                        else
                                                        {
                                                            <i class="far fa-star text-muted"></i>
                                                        }
                                                    }
                                                </div>
                                            </td>
                                            <td>
                                                <small class="text-muted">
                                                    @book.AverageRating.ToString("F1") (@book.RatingCount)
                                                </small>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <p class="text-muted">Henüz puanlanmış kitap bulunmuyor.</p>
                    }
                </div>
                <div class="card-footer">
                    <a href="@Url.Action("TopRated", "Books")" class="btn btn-warning btn-sm">
                        <i class="fas fa-star"></i> Tüm Puanlı Kitapları Gör
                    </a>
                </div>
            </div>
        </div>

        <!-- Sağ Kolon -->
        <div class="col-lg-4">
            <!-- Son Aktiviteler -->
            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="card-title">
                        <i class="fas fa-clock text-info"></i> Son Aktiviteler
                    </h5>
                </div>
                <div class="card-body" style="max-height: 400px; overflow-y: auto;">
                    @if (Model.RecentLoans != null && Model.RecentLoans.Count > 0)
                    {
                        <div class="timeline">
                            @foreach (var loan in Model.RecentLoans)
                            {
                                <div class="timeline-item">
                                    <div class="timeline-marker
                                                @(loan.ReturnDate == null ? "bg-warning" : "bg-success")">
                                        <i class="fas @(loan.ReturnDate == null ? "fa-hand-holding" : "fa-undo")"></i>
                                    </div>
                                    <div class="timeline-content">
                                        <small class="text-muted">@loan.LoanDate.ToString("dd.MM.yyyy HH:mm")</small><br />
                                        <strong>@loan.Member.FullName</strong><br />
                                        <a href="@Url.Action("Details", "Books", new { id = loan.BookId })">
                                            @loan.Book.Title
                                        </a><br />
                                        @if (loan.ReturnDate == null)
                                        {
                                            <span class="badge badge-warning">Ödünç Alındı</span>
                                            @if (loan.DueDate < DateTime.Now)
                                            {
                                                <span class="badge badge-danger">Gecikmeli</span>
                                            }
                                        }
                                        else
                                        {
                                            <span class="badge badge-success">İade Edildi</span>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="text-muted">Henüz aktivite bulunmuyor.</p>
                    }
                </div>
                <div class="card-footer">
                    <a href="@Url.Action("Index", "Loans")" class="btn btn-info btn-sm">
                        <i class="fas fa-list"></i> Tüm Aktiviteleri Gör
                    </a>
                </div>
            </div>

            <!-- Gecikmeli Kitaplar -->
            @if (Model.OverdueBooks != null && Model.OverdueBooks.Count > 0)
            {
                <div class="card mb-4">
                    <div class="card-header bg-danger text-white">
                        <h5 class="card-title mb-0">
                            <i class="fas fa-exclamation-triangle"></i> Gecikmeli Kitaplar
                        </h5>
                    </div>
                    <div class="card-body">
                        @foreach (var loan in Model.OverdueBooks)
                        {
                            <div class="media mb-2">
                                <div class="media-body">
                                    <h6 class="mt-0">
                                        <a href="@Url.Action("Details", "Books", new { id = loan.BookId })">
                                            @loan.Book.Title
                                        </a>
                                    </h6>
                                    <small class="text-muted">
                                        @loan.Member.FullName<br />
                                        Teslim: @loan.DueDate.ToString("dd.MM.yyyy")<br />
                                        <span class="text-danger">
                                            @((DateTime.Now.Date - loan.DueDate.Date).Days) gün gecikme
                                        </span>
                                    </small>
                                </div>
                            </div>
                            <hr />
                        }
                    </div>
                    <div class="card-footer">
                        <a href="@Url.Action("OverdueBooks", "Loans")" class="btn btn-danger btn-sm">
                            <i class="fas fa-exclamation-triangle"></i> Tüm Gecikmeleri Gör
                        </a>
                    </div>
                </div>
            }

            <!-- Hızlı İşlemler -->
            <div class="card">
                <div class="card-header">
                    <h5 class="card-title">
                        <i class="fas fa-bolt text-primary"></i> Hızlı İşlemler
                    </h5>
                </div>
                <div class="card-body">
                    <div class="d-grid gap-2">
                        <a href="@Url.Action("Create", "Books")" class="btn btn-primary btn-sm">
                            <i class="fas fa-plus"></i> Yeni Kitap Ekle
                        </a>
                        <a href="@Url.Action("Create", "Members")" class="btn btn-success btn-sm">
                            <i class="fas fa-user-plus"></i> Yeni Üye Ekle
                        </a>
                        <a href="@Url.Action("Create", "Loans")" class="btn btn-warning btn-sm">
                            <i class="fas fa-hand-holding"></i> Kitap Ödünç Ver
                        </a>
                        <a href="@Url.Action("Index", "Reports")" class="btn btn-info btn-sm">
                            <i class="fas fa-chart-bar"></i> Raporları Görüntüle
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .timeline {
            position: relative;
            padding-left: 30px;
        }

            .timeline::before {
                content: '';
                position: absolute;
                left: 15px;
                top: 0;
                bottom: 0;
                width: 2px;
                background: #dee2e6;
            }

        .timeline-item {
            position: relative;
            margin-bottom: 20px;
        }

        .timeline-marker {
            position: absolute;
            left: -22px;
            width: 30px;
            height: 30px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 12px;
        }

        .timeline-content {
            background: #f8f9fa;
            padding: 10px;
            border-radius: 5px;
            border-left: 3px solid #007bff;
        }

        .card {
            box-shadow: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.075);
            border: 1px solid rgba(0, 0, 0, 0.125);
        }

        .card-header {
            background-color: rgba(0, 0, 0, 0.03);
            border-bottom: 1px solid rgba(0, 0, 0, 0.125);
        }
    </style>
}

@section Scripts {
    <script>
        $(document).ready(function() {
            // Auto-refresh dashboard stats every 5 minutes
            setInterval(function() {
                $.get('@Url.Action("GetDashboardStats", "Home")', function(data) {
                    // Update stats if needed
                });
            }, 300000); // 5 minutes

            // Initialize tooltips
            $('[data-toggle="tooltip"]').tooltip();
        });
    </script>
}


