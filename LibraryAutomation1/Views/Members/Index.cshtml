@model IEnumerable<LibraryAutomation1.Models.Member>

@{
    ViewData["Title"] = "Üyeler";
}

<h1>Üyeler</h1>

<p>
    <!-- Yeni üye ekleme butonu -->
    <a asp-action="Create" class="btn btn-primary">Yeni Üye Ekle</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>Ad</th>
            <th>Soyad</th>
            <th>İşlemler</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@Html.DisplayFor(modelItem => item.FirstName)</td>
                <td>@Html.DisplayFor(modelItem => item.LastName)</td>
                <td>
                    <!-- İşlem butonları -->
                    <a asp-controller="Members" asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Düzenle</a>
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info">Detay</a>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Sil</a>
                </td>
            </tr>
        }
    </tbody>
</table>

