@model IEnumerable<dynamic>
@{
    ViewData["Title"] = "Geciken Ödünçler";
    var toplamCeza = ViewBag.TotalOverdueFees;
}

<h2>Geciken Ödünçler</h2>
<p><strong>Toplam Tahmini Gecikme Ücreti:</strong> @toplamCeza ₺</p>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Üye</th>
            <th>Kitap</th>
            <th>Ödünç Tarihi</th>
            <th>Son Teslim Tarihi</th>
            <th>Gecikme (Gün)</th>
            <th>Tahmini Ücret (₺)</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Loan.Member.FullName</td>
                <td>@item.Loan.Book.Title</td>
                <td>@item.Loan.LoanDate.ToString("dd.MM.yyyy")</td>
                <td>@item.Loan.DueDate.ToString("dd.MM.yyyy")</td>
                <td>@item.DaysOverdue</td>
                <td>@item.EstimatedFee.ToString("0.00")</td>
            </tr>
        }
    </tbody>
</table>
